# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Anthropic (Claude) — used to synthesize the search brief from both partners'
# preferences, refine rounds, and personalize based on watch history.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# TMDB — https://www.themoviedb.org/settings/api (use the v4 "API Read Access Token")
TMDB_API_KEY=

# RapidAPI — "Streaming Availability" by movie-of-the-night
# https://rapidapi.com/movie-of-the-night-movie-of-the-night-default/api/streaming-availability
RAPIDAPI_KEY=
RAPIDAPI_HOST=streaming-availability.p.rapidapi.com

# Supabase — https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key is server-only, never exposed to the browser. Used by API
# routes to write session/swipe data.
SUPABASE_SERVICE_ROLE_KEY=
