# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Google Gemini — used to synthesize the search brief from both partners'
# preferences, refine rounds, and personalize based on watch history.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# TMDB — https://www.themoviedb.org/settings/api
# Use the v4 "API Read Access Token" (starts with eyJ) OR a v3 API key.
TMDB_API_KEY=
TMDB_READ_ACCESS_TOKEN=

# RapidAPI — "OTT Details" for streaming availability in India
# https://rapidapi.com/gox-ai-gox-ai-default/api/ott-details
RAPIDAPI_KEY=
RAPIDAPI_HOST=ott-details.p.rapidapi.com

# Supabase — https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key is server-only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ACCESS_TOKEN=
